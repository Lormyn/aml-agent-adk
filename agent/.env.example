# Google Cloud Configuration (Required)
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=gs://your-staging-bucket

# MCP Toolbox URL (Required)
# Deploy the MCP Toolbox to Cloud Run first, then set this URL
MCP_URL=https://your-toolbox-url.run.app/mcp

# Agent Engine Configuration (Set after first deployment)
AGENT_ENGINE_ID=

# Telemetry (Optional)
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=true
